PORT=4000
MONGODB_URI=mongodb://localhost:27017/ims
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Comma-separated origins allowed by CORS, e.g. http://localhost:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional: Firebase Cloud Messaging server key
FCM_SERVER_KEY=

# Optional: super admin bootstrap defaults
SUPER_ADMIN_EMAIL=superadmin@baliraja.com
SUPER_ADMIN_PASSWORD=123456
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_FORCE_RESET=false

# Optional: secure setup/admin utilities
BOOTSTRAP_KEY=
REVENUE_PASS=
