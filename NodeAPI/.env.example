PORT=4000
MONGODB_URI=mongodb://localhost:27017/ims
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=25m

# Comma-separated origins allowed by CORS, e.g. http://localhost:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional: Firebase Cloud Messaging server key
FCM_SERVER_KEY=

# Optional: super admin bootstrap defaults
SUPER_ADMIN_EMAIL=superadmin@cognitix.tech
SUPER_ADMIN_PASSWORD=123456
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_FORCE_RESET=false

# Optional: secure setup/admin utilities
BOOTSTRAP_KEY=
REVENUE_PASS=

# Super admin recovery email destination
SUPER_ADMIN_RECOVERY_EMAIL=hrinfocognitix@gmail.com

# SMTP / email config for forgot password mails
# Option A (Gmail):
RESET_EMAIL_USER=
RESET_EMAIL_APP_PASSWORD=
RESET_EMAIL_FROM=
#
# Option B (custom SMTP):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
#
# Option C (SMTP without auth, only if your mail server allows it):
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_NO_AUTH=true
# RESET_EMAIL_FROM=no-reply@your-domain.com

# Recommended local setup:
# 1. Copy this file to `.env.development.local` for local API + local DB
# 2. Create `.env.production.local` only if you want to test against production DB/API values locally
# 3. Render production env vars will still override these values on the server
