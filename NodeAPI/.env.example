PORT=4000
MONGODB_URI=mongodb://localhost:27017/ims
JWT_SECRET=changeme-super-secret

# Comma-separated origins allowed by CORS, e.g. http://localhost:3000,http://localhost:5173
CORS_ORIGIN=*

# Firebase Cloud Messaging server key (from Firebase Console -> Project Settings -> Cloud Messaging -> Server key)
FCM_SERVER_KEY=your-server-key-here
